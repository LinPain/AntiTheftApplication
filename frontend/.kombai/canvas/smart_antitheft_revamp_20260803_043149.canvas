ss=\"text-[#F94D00]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-1\" data-name=\"log entry timestamp\" data-reason=\"text updated as logs stream in\">\n                                12:40:44\n                            </span>\n                            <span data-kid=\"1-2-2-2-3-2-3-2\">\n                                SIM fingerprint mismatch\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section aria-label=\"Quick response actions\" class=\"aurora-reveal border-y border-[#d9d2ca] py-5\" data-kid=\"1-2-3\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1\">\n                <div data-kid=\"1-2-3-1-1\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#7a83a5]\" data-kid=\"1-2-3-1-1-1\">\n                        Immediate response\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#66709a]\" data-kid=\"1-2-3-1-1-2\">\n                        Mọi thao tác được ghi lại vào nhật ký bảo mật.\n                    </div>\n                </div>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-3-1-2\">\n                    <button aria-label=\"Khóa thiết bị từ xa\" class=\"aurora-focus aurora-action flex items-center gap-3 border border-[#002387] px-4 py-3 text-left text-[#002387]\" data-kid=\"1-2-3-1-2-1\" title=\"Khóa thiết bị từ xa\">\n                        <i aria-hidden=\"true\" class=\"ti ti-lock text-[18px]\" data-kid=\"1-2-3-1-2-1-1\">\n                        </i>\n                        <span data-kid=\"1-2-3-1-2-1-2\">\n                            <span class=\"block text-[12px] font-bold\" data-kid=\"1-2-3-1-2-1-2-1\">\n                                Khóa thiết bị\n                            </span>\n                            <span class=\"block text-[10px]\" data-kid=\"1-2-3-1-2