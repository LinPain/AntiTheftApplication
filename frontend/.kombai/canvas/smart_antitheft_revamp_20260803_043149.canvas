      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Overpass:wght@400;500;600;700&family=Schibsted+Grotesk:wght@500;600;700&display=swap');\n.aurora-root{font-family:'Overpass',sans-serif;background:#FFFAFA;color:#002387;}\n.aurora-heading{font-family:'Schibsted Grotesk',sans-serif;letter-spacing:-0.035em;}\n.aurora-map{background-color:#F4F0EC;background-image:linear-gradient(rgba(0,35,135,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(0,35,135,.055) 1px,transparent 1px),linear-gradient(135deg,rgba(249,77,0,.05),transparent 38%);background-size:32px 32px,32px 32px,100% 100%;}\n.aurora-map:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,250,250,.7),transparent 20%,transparent 80%,rgba(255,250,250,.45));pointer-events:none;}\n.aurora-route{stroke-dasharray:8 9;}\n.aurora-pin{filter:drop-shadow(0 5px 3px rgba(0,35,135,.14));}\n.aurora-callout{box-shadow:0 8px 24px rgba(0,35,135,.07);}\n.aurora-action:hover{background:#002387;color:#FFFAFA;}\n.aurora-action-danger:hover{background:#F94D00;color:#FFFAFA;}\n.aurora-tab:hover{color:#F94D00;}\n.aurora-focus:focus-visible{outline:3px solid #F94D00;outline-offset:3px;}\n.aurora-soft-rule{background:linear-gradient(90deg,#002387 0 18%,#d9d2ca 18% 100%);}\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (typeof gsap === 'undefined') return;\n  const reveal = document.querySelectorAll('.aurora-reveal');\n  const pins = document.querySelectorAll('.aurora-pin');\n  const controls = document.querySelectorAll('button:not(.aurora-action):not(.aurora-action-danger)');\n  const actions = document.querySelectorAll('.aurora-action, .aurora-action-danger');\n  const callouts = document.querySelectorAll('.aurora-callout');\n  const timelineItems = document.querySelectorAll('aside[aria-labelledby=\"timeline-title\"] .relative.flex.gap-4');\n  const setReady = () => {\n    gsap.set(reveal, { clearProps: 'all' });\n    gsap.set('.aurora-route', { strokeDashoffset: 0 });\n    gsap.set('.aurora-live-dot, .aurora-pin-current, .aurora-marker-ring', { clearProps: 'all' });\n  };\n  if (reduce) { setReady(); return; }\n\n  gsap.timeline({ defaults: { ease: 'power3.out' } })\n    .from(reveal, { autoAlpha: 0, y: 20, duration: 0.55, stagger: 0.055 })\n    .from(timelineItems, { autoAlpha: 0, x: 20, duration: 0.38, stagger: 0.12 }, '-=0.25')\n    .from('.aurora-route', { strokeDashoffset: 180, duration: 1.2, ease: 'power2.inOut' }, '-=0.35');\n  gsap.to('.aurora-live-dot', { scale: 1.55, autoAlpha: 0.35, duration: 1.15, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n  gsap.to('.aurora-pin-current', { scale: 1.12, duration: 1.25, repeat: -1, yoyo: true, ease: 'sine.inOut', transformOrigin: '50% 50%' });\n  gsap.fromTo('.aurora-marker-ring', { autoAlpha: 0.65, scale: 0.7 }, { autoAlpha: 0, scale: 1.85, duration: 1.8, repeat: -1, ease: 'power1.out', transformOrigin: '50% 50%' });\n  gsap.to('.aurora-map', { backgroundPosition: '32px 32px', duration: 10, repeat: -1, ease: 'none' });\n  gsap.fromTo('.aurora-callout', { y: 6, autoAlpha: 0.76 }, { y: 0, autoAlpha: 1, duration: 1.6, repeat: -1, yoyo: true, stagger: 0.18, ease: 'sine.inOut' });\n\n  controls.forEach((button) => {\n    const hover = gsap.to(button, { y: -2, scale: 1.04, duration: 0.2, ease: 'power2.out', paused: true });\n    button.addEventListener('pointerenter', () => hover.play());\n    button.addEventListener('pointerleave', () => hover.reverse());\n    button.addEventListener('focus', () => hover.play());\n    button.addEventListener('blur', () => hover.reverse());\n    button.addEventListener('pointerdown', () => gsap.to(button, { scale: 0.94, duration: 0.1, ease: 'power2.out' }));\n    button.addEventListener('pointerup', () => gsap.to(button, { scale: 1.04, duration: 0.16, ease: 'back.out(1.7)' }));\n  });\n  callouts.forEach((callout) => {\n    const hover = gsap.to(callout, { scale: 1.03, boxShadow: '0 14px 32px rgba(0,35,135,.16)', duration: 0.2, ease: 'power2.out', paused: true });\n    callout.addEventListener('pointerenter', () => hover.play());\n    callout.addEventListener('pointerleave', () => hover.reverse());\n  });\n  pins.forEach((pin) => {\n    const hover = gsap.to(pin, { scale: 1.22, duration: 0.22, ease: 'back.out(1.7)', paused: true, transformOrigin: '50% 50%' });\n    pin.addEventListener('pointerenter', () => hover.play());\n    pin.addEventListener('pointerleave', () => hover.reverse());\n  });\n  actions.forEach((button) => {\n    const hover = gsap.to(button, { y: -3, duration: 0.18, ease: 'power2.out', paused: true });\n    button.addEventListener('pointerenter', () => hover.play());\n    button.addEventListener('pointerleave', () => hover.reverse());\n    button.addEventListener('focus', () => hover.play());\n    button.addEventListener('blur', () => hover.reverse());\n    button.addEventListener('pointerdown', () => gsap.to(button, { scale: 0.975, duration: 0.08, ease: 'power2.out' }));\n    button.addEventListener('pointerup', () => gsap.to(button, { scale: 1, duration: 0.18, ease: 'back.out(2)' }));\n  });\n})();\n</script>\n<div class=\"aurora-root min-h-screen px-6 py-5 md:px-10 md:py-7\" data-kid=\"1\">\n    <header class=\"mx-auto max-w-[1240px] aurora-reveal\" data-kid=\"1-1\">\n        <div class=\"flex flex-wrap items-center justify-between gap-5 border-b border-[#d9d2ca] pb-5\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\">\n                <div aria-label=\"Aurora Secure logo\" class=\"flex h-11 w-11 items-center justify-center border border-[#002387] bg-[#002387] text-[#FFFAFA]\" data-kid=\"1-1-1-1-1\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shield-check text-[24px]\" data-kid=\"1-1-1-1-1-1\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"aurora-heading text-[20px] font-semibold leading-none\" data-kid=\"1-1-1-1-2-1\">\n                        AURORA\n                        <span class=\"font-normal\" data-kid=\"1-1-1-1-2-1-1\">\n                            SECURE\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-[#66709a]\" data-kid=\"1-1-1-1-2-2\">\n                        Mobile recovery console · v2.4\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4 text-[12px] text-[#5e6b96]\" data-kid=\"1-1-1-2\">\n                <div class=\"flex items-center gap-2 border-l border-[#d9d2ca] pl-4\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"aurora-live-dot h-2 w-2 rounded-full bg-[#F94D00]\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    <span class=\"font-semibold uppercase tracking-[0.1em] text-[#002387]\" data-kid=\"1-1-1-2-1-2\">\n                        Live sync\n                    </span>\n                    <span data-dynamic=\"true\" data-kid=\"1-1-1-2-1-3\" data-name=\"live sync last updated time\" data-reason=\"text replaced every few seconds by sync script\">\n                        12 sec ago\n                    </span>\n                </div>\n                <button aria-label=\"Open security settings\" class=\"aurora-focus flex h-9 w-9 items-center justify-center border border-[#d9d2ca] bg-[#FFFAFA] hover:border-[#002387]\" data-kid=\"1-1-1-2-2\" title=\"Security settings\">\n                    <i class=\"ti ti-adjustments-horizontal text-[18px]\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                </button>\n                <div class=\"flex items-center gap-2 border-l border-[#d9d2ca] pl-4\" data-kid=\"1-1-1-2-3\">\n                    <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#002387] text-[11px] font-bold text-[#FFFAFA]\" data-kid=\"1-1-1-2-3-1\">\n                        NM\n                    </span>\n                    <span class=\"hidden font-semibold text-[#002387] sm:block\" data-kid=\"1-1-1-2-3-2\">\n                        Nguyễn Minh\n                    </span>\n                </div>\n            </div>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"flex items-end gap-7 overflow-x-auto pt-4\" data-kid=\"1-1-2\">\n            <button aria-selected=\"true\" class=\"aurora-focus aurora-tab border-b-2 border-[#F94D00] pb-3 text-[13px] font-bold text-[#002387]\" data-kid=\"1-1-2-1\" role=\"tab\">\n                Tổng quan\n            </button>\n            <button aria-selected=\"false\" class=\"aurora-focus aurora-tab border-b-2 border-transparent pb-3 text-[13px] font-medium text-[#68729a]\" data-kid=\"1-1-2-2\" role=\"tab\">\n                Thiết bị\n            </button>\n            <button aria-selected=\"false\" class=\"aurora-focus aurora-tab border-b-2 border-transparent pb-3 text-[13px] font-medium text-[#68729a]\" data-kid=\"1-1-2-3\" role=\"tab\">\n                Bản đồ\n            </button>\n            <button aria-selected=\"false\" class=\"aurora-focus aurora-tab border-b-2 border-transparent pb-3 text-[13px] font-medium text-[#68729a]\" data-kid=\"1-1-2-4\" role=\"tab\">\n                Lịch sử\n            </button>\n            <span class=\"ml-auto hidden pb-3 text-[11px] uppercase tracking-[0.15em] text-[#8890ac] lg:block\" data-kid=\"1-1-2-5\">\n                Case ID · AS-2048-11\n            </span>\n        </nav>\n    </header>\n    <main class=\"mx-auto max-w-[1240px]\" data-kid=\"1-2\">\n        <section aria-labelledby=\"overview-title\" class=\"aurora-reveal border-b border-[#d9d2ca] py-7\" data-kid=\"1-2-1\">\n            <div class=\"flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-1-1\">\n                <div data-kid=\"1-2-1-1-1\">\n                    <div class=\"mb-3 flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.18em] text-[#F94D00]\" data-kid=\"1-2-1-1-1-1\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#F94D00]\" data-kid=\"1-2-1-1-1-1-1\">\n                        </span>\n                        Bảo vệ đang hoạt động\n                    </div>\n                    <h1 class=\"aurora-heading text-[clamp(32px,4vw,52px)] font-semibold leading-[.95]\" data-kid=\"1-2-1-1-1-2\" id=\"overview-title\">\n                        Galaxy S24 Ultra\n                        <br data-kid=\"1-2-1-1-1-2-1\"/>\n                        <span class=\"text-[#65709b]\" data-kid=\"1-2-1-1-1-2-2\">\n                            đang được theo dõi\n                        </span>\n                    </h1>\n                </div>\n                <div class=\"max-w-[330px] text-[13px] leading-6 text-[#66709a]\" data-kid=\"1-2-1-1-2\">\n                    Hệ thống đang ghi nhận vị trí và sự kiện bảo mật. Nếu bạn nghi ngờ thiết bị bị đánh cắp, hãy kích hoạt khóa từ xa ngay.\n                </div>\n            </div>\n            <div class=\"mt-7 grid grid-cols-[minmax(250px,1.7fr)_repeat(3,minmax(130px,1fr))] items-end gap-0 border-t border-[#d9d2ca] pt-5 md:grid-cols-[minmax(250px,1.6fr)_repeat(3,1fr)]\" data-kid=\"1-2-1-2\">\n                <div class=\"border-r border-[#d9d2ca] pr-6\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#7a83a5]\" data-kid=\"1-2-1-2-1-1\">\n                        Trạng thái hiện tại\n                    </div>\n                    <div class=\"aurora-heading mt-2 text-[25px] font-semibold text-[#002387]\" data-kid=\"1-2-1-2-1-2\">\n                        Tracking active\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#66709a]\" data-kid=\"1-2-1-2-1-3\">\n                        Kết nối mã hóa · thiết bị trực tuyến\n                    </div>\n                </div>\n                <div class=\"border-r border-[#d9d2ca] px-5\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#7a83a5]\" data-kid=\"1-2-1-2-2-1\">\n                        Pin còn lại\n                    </div>\n                    <div class=\"aurora-heading mt-2 text-[25px] font-semibold\" data-kid=\"1-2-1-2-2-2\">\n                        72\n                        <span class=\"text-[15px]\" data-kid=\"1-2-1-2-2-2-1\">\n                            %\n                        </span>\n                    </div>\n                    <div class=\"mt-2 h-1.5 bg-[#d9d2ca]\" data-kid=\"1-2-1-2-2-3\">\n                        <div class=\"h-full w-[72%] bg-[#002387]\" data-kid=\"1-2-1-2-2-3-1\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"border-r border-[#d9d2ca] px-5\" data-kid=\"1-2-1-2-3\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#7a83a5]\" data-kid=\"1-2-1-2-3-1\">\n                        Ping cuối\n                    </div>\n                    <div class=\"aurora-heading mt-2 text-[25px] font-semibold\" data-kid=\"1-2-1-2-3-2\">\n                        12\n                        <span class=\"text-[15px]\" data-kid=\"1-2-1-2-3-2-1\">\n                            s\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#66709a]\" data-kid=\"1-2-1-2-3-3\">\n                        vừa cập nhật\n                    </div>\n                </div>\n                <div class=\"px-5\" data-kid=\"1-2-1-2-4\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#7a83a5]\" data-kid=\"1-2-1-2-4-1\">\n                        Độ chính xác\n                    </div>\n                    <div class=\"aurora-heading mt-2 text-[25px] font-semibold\" data-kid=\"1-2-1-2-4-2\">\n                        4.2\n                        <span class=\"text-[15px]\" data-kid=\"1-2-1-2-4-2-1\">\n                            m\n                        </span>\n                    </div>\n                    <div class=\"mt-1 text-[12px] text-[#66709a]\" data-kid=\"1-2-1-2-4-3\">\n                        GPS + Wi-Fi\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"grid gap-8 py-8 lg:grid-cols-[minmax(0,1.62fr)_minmax(300px,.78fr)]\" data-kid=\"1-2-2\">\n            <article aria-labelledby=\"map-title\" class=\"aurora-reveal min-w-0\" data-kid=\"1-2-2-1\">\n                <div class=\"mb-4 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-2-2-1-1\">\n                    <div data-kid=\"1-2-2-1-1-1\">\n                        <div class=\"text-[10px] font-bold uppercase tracking-[0.18em] text-[#7a83a5]\" data-kid=\"1-2-2-1-1-1-1\">\n                            Live location / 01\n                        </div>\n                        <h2 class=\"aurora-heading mt-1 text-[25px] font-semibold\" data-kid=\"1-2-2-1-1-1-2\" id=\"map-title\">\n                            Vị trí gần nhất\n                        </h2>\n                    </div>\n                    <div class=\"text-right text-[12px] text-[#66709a]\" data-kid=\"1-2-2-1-1-2\">\n                        <div class=\"font-semibold text-[#002387]\" data-kid=\"1-2-2-1-1-2-1\">\n                            Quận 1 · TP. Hồ Chí Minh\n                        </div>\n                        <div data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"last ping timestamp\" data-reason=\"text replaced by live map update script\">\n                            10.7769° N, 106.7009° E\n                        </div>\n                    </div>\n                </div>\n                <div aria-label=\"Bản đồ 2D khu vực Quận 1 với đường đi và vị trí Galaxy S24 Ultra\" class=\"aurora-map relative h-[420px] overflow-hidden border border-[#d9d2ca]\" data-kid=\"1-2-2-1-2\" role=\"img\">\n                    <svg aria-hidden=\"true\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-2-2-1-2-1\" data-name=\"live tracking map SVG\" preserveaspectratio=\"none\" viewbox=\"0 0 820 420\">\n                        <path d=\"M-20 83 C130 60 168 124 270 96 S455 28 580 92 S710 142 850 82\" fill=\"none\" opacity=\".8\" stroke=\"#d1c9c0\" stroke-width=\"16\">\n                        </path>\n                        <path d=\"M-20 83 C130 60 168 124 270 96 S455 28 580 92 S710 142 850 82\" fill=\"none\" opacity=\".95\" stroke=\"#FFFAFA\" stroke-width=\"8\">\n                        </path>\n                        <path d=\"M88 -15 C130 76 105 123 162 194 S220 326 184 438\" fill=\"none\" opacity=\".76\" stroke=\"#d1c9c0\" stroke-width=\"13\">\n                        </path>\n                        <path d=\"M88 -15 C130 76 105 123 162 194 S220 326 184 438\" fill=\"none\" opacity=\".95\" stroke=\"#FFFAFA\" stroke-width=\"6\">\n                        </path>\n                        <path d=\"M470 -20 C430 66 495 112 452 181 S402 321 490 438\" fill=\"none\" opacity=\".74\" stroke=\"#d1c9c0\" stroke-width=\"11\">\n                        </path>\n                        <path d=\"M470 -20 C430 66 495 112 452 181 S402 321 490 438\" fill=\"none\" opacity=\".95\" stroke=\"#FFFAFA\" stroke-width=\"5\">\n                        </path>\n                        <path d=\"M655 -20 C610 80 678 142 625 232 S662 350 720 438\" fill=\"none\" opacity=\".7\" stroke=\"#d1c9c0\" stroke-width=\"18\">\n                        </path>\n                        <path d=\"M655 -20 C610 80 678 142 625 232 S662 350 720 438\" fill=\"none\" opacity=\".92\" stroke=\"#FFFAFA\" stroke-width=\"9\">\n                        </path>\n                        <path d=\"M20 328 C174 280 274 333 348 286 S520 209 612 274 S742 328 850 282\" fill=\"none\" opacity=\".8\" stroke=\"#d8d0c7\" stroke-width=\"10\">\n                        </path>\n                        <path d=\"M20 328 C174 280 274 333 348 286 S520 209 612 274 S742 328 850 282\" fill=\"none\" opacity=\".95\" stroke=\"#FFFAFA\" stroke-width=\"5\">\n                        </path>\n                        <path class=\"aurora-route\" d=\"M118 292 C215 264 266 211 354 228 S518 300 596 222 S678 183 744 202\" fill=\"none\" stroke=\"#002387\" stroke-width=\"4\">\n                        </path>\n                        <path d=\"M118 292 C215 264 266 211 354 228 S518 300 596 222 S678 183 744 202\" fill=\"none\" opacity=\".9\" stroke=\"#F94D00\" stroke-dasharray=\"2 12\" stroke-width=\"1.5\">\n                        </path>\n                        <g fill=\"#002387\" opacity=\".18\">\n                            <circle cx=\"188\" cy=\"147\" r=\"18\">\n                            </circle>\n                            <circle cx=\"292\" cy=\"333\" r=\"13\">\n                            </circle>\n                            <circle cx=\"558\" cy=\"146\" r=\"20\">\n                            </circle>\n                            <circle cx=\"704\" cy=\"309\" r=\"15\">\n                            </circle>\n                        </g>\n                        <g class=\"aurora-pin\" transform=\"translate(118 292)\">\n                            <circle fill=\"#F94D00\" r=\"8\">\n                            </circle>\n                            <circle fill=\"#FFFAFA\" r=\"3\">\n                            </circle>\n                        </g>\n                        <g class=\"aurora-pin\" transform=\"translate(354 228)\">\n                            <circle fill=\"#002387\" r=\"6\">\n                            </circle>\n                            <circle fill=\"#FFFAFA\" r=\"2.5\">\n                            </circle>\n                        </g>\n                        <g class=\"aurora-pin-current\" transform=\"translate(744 202)\">\n                            <circle fill=\"#002387\" opacity=\".16\" r=\"12\">\n                            </circle>\n                            <circle fill=\"#002387\" r=\"7\">\n                            </circle>\n                            <circle fill=\"#FFFAFA\" r=\"3\">\n                            </circle>\n                        </g>\n                        <circle class=\"aurora-marker-ring\" cx=\"744\" cy=\"202\" fill=\"none\" r=\"16\" stroke=\"#F94D00\" stroke-width=\"2\">\n                        </circle>\n                    </svg>\n                    <div class=\"absolute left-5 top-5 flex items-center gap-2 border border-[#d9d2ca] bg-[#FFFAFA]/95 px-3 py-2 text-[11px] font-semibold text-[#002387]\" data-kid=\"1-2-2-1-2-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-2 text-[15px]\" data-kid=\"1-2-2-1-2-2-1\">\n                        </i>\n                        Street layer\n                        <span class=\"ml-2 text-[#7a83a5]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"map layer update interval text\" data-reason=\"text replaced every few seconds by sync script\">\n                            · cập nhật 12s\n                        </span>\n                    </div>\n                    <div class=\"aurora-callout absolute left-[10%] top-[55%] w-[170px] border border-[#d9d2ca] bg-[#FFFAFA] p-3 text-[11px] text-[#002387]\" data-kid=\"1-2-2-1-2-3\" data-name=\"interactive map callout\">\n                        <div class=\"mb-1 flex items-center gap-2 font-bold\" data-kid=\"1-2-2-1-2-3-1\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#F94D00]\" data-kid=\"1-2-2-1-2-3-1-1\">\n                            </span>\n                            14:02 · Wi-Fi lost\n                        </div>\n                        <div class=\"leading-4 text-[#66709a]\" data-kid=\"1-2-2-1-2-3-2\">\n                            Thiết bị rời mạng quen thuộc\n                        </div>\n                    </div>\n                    <div class