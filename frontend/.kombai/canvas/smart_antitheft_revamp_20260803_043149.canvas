        </div>\n                                <div class=\"mt-0.5 text-xs text-slate-300\" data-kid=\"2-1-1-2-3-1-1-2-2\">\n                                    Chỉ thao tác khi đã xác nhận đúng thiết bị\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex flex-wrap gap-2\" data-kid=\"2-1-1-2-3-1-2\">\n                            <button aria-label=\"Khóa thiết bị\" class=\"action flex items-center gap-2 border border-[#0FFFFF]/50 bg-[#0FFFFF]/10 px-4 py-2.5 text-xs font-semibold text-[#0FFFFF] hover:bg-[#0FFFFF] hover:text-[#010B13]\" data-kid=\"2-1-1-2-3-1-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-lock text-[17px]\" data-kid=\"2-1-1-2-3-1-2-1-1\">\n                                </i>\n                                Khóa thiết bị\n                            </button>\n                            <button aria-label=\"Phát còi\" class=\"action flex items-center gap-2 border border-[#0FFFFF]/50 bg-[#0FFFFF]/10 px-4 py-2.5 text-xs font-semibold text-[#0FFFFF] hover:bg-[#0FFFFF] hover:text-[#010B13]\" data-kid=\"2-1-1-2-3-1-2-2\">\n                                <i aria-hidden=\"true\" class=\"ti ti-volume-2 text-[17px]\" data-kid=\"2-1-1-2-3-1-2-2-1\">\n                                </i>\n                                Phát còi\n                            </button>\n                            <button aria-label=\"Xóa dữ liệu từ xa\" class=\"action flex items-center gap-2 border border-[#DC343B]/70 bg-[#DC343B]/10 px-4 py-2.5 text-xs font-semibold text-[#ff969b] hover:bg-[#DC343B] hover:text-white\" data-kid=\"2-1-1-2-3-1-2-3\">\n                                <i aria-hidden=\"true\" class=\"ti ti-skull text-[17px]\" data-kid=\"2-1-1-2-3-1-2-3-1\">\n                                </i>\n                                Xóa dữ liệu\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-end gap-2 border-t border-[#0FFFFF]/10 pt-3 sentinel-mono text-[10px] uppercase tracking-[.13em] text-slate-500\" data-kid=\"2-1-1-2-3-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-alert-triangle text-[13px] text-[#ff969b]\" data-kid=\"2-1-1-2-3-2-1\">\n                        </i>\n                        Xóa dữ liệu sẽ không thể hoàn tác · cần xác nhận hai bước\n                    </div>\n                </section>\n                <footer class=\"reveal mt-5 flex flex-col gap-2 border-t border-[#0FFFFF]/12 pt-4 text-[10px] text-slate-600 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"2-1-1-2-4\">\n                    <span class=\"sentinel-mono uppercase tracking-[.15em]\" data-kid=\"2-1-1-2-4-1\">\n                        SNTL / Privacy-first device recovery\n                    </span>\n                    <span class=\"sentinel-mono\" data-kid=\"2-1-1-2-4-2\">\n                        Encrypted telemetry · v2.4.1 · © 2026\n                    </span>\n                </footer>\n            </main>\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    (() => {\n  const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (typeof gsap === 'undefined') return;\n  const reveal = document.querySelectorAll('.reveal');\n  const utilityControls = document.querySelectorAll('button:not(.action)');\n  const actions = document.querySelectorAll('.action');\n  const threatCard = document.querySelector('[aria-label=\"Cảnh báo và bằng chứng\"] > div:first-child');\n  const proofRows = document.querySelectorAll('[data-name=\"live proof ticker container\"] > div');\n  const setStill = () => {\n    gsap.set(reveal, { clearProps: 'all' });\n    gsap.set('.route-path', { strokeDashoffset: 0 });\n    gsap.set('.radar-ring, .marker-ping, .live-dot', { clearProps: 'all' });\n  };\n  if (reduceMotion) { setStill(); return; }\n\n  const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n  intro.from(reveal, { autoAlpha: 0, y: 18, duration: 0.6, stagger: 0.08 })\n    .from(threatCard, { autoAlpha: 0, x: 28, scale: 0.96, duration: 0.5 }, '-=0.28')\n    .from(proofRows, { autoAlpha: 0, x: 16, duration: 0.32, stagger: 0.06 }, '-=0.2');\n  gsap.fromTo('.route-path', { strokeDashoffset: 320 }, { strokeDashoffset: 0, duration: 1.8, ease: 'power2.out', delay: 0.35 });\n  gsap.fromTo('.radar-ring', { scale: 0.82, autoAlpha: 0.18 }, { scale: 1.12, autoAlpha: 0.72, duration: 1.9, repeat: -1, yoyo: true, stagger: 0.25, ease: 'sine.inOut' });\n  gsap.fromTo('.marker-ping', { scale: 0.55, autoAlpha: 0.65 }, { scale: 1.5, autoAlpha: 0, duration: 1.35, repeat: -1, ease: 'sine.out' });\n  gsap.to('.live-dot', { scale: 1.35, autoAlpha: 0.55, duration: 0.8, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n  gsap.to('.map-grid', { backgroundPosition: '44px 44px', duration: 8, repeat: -1, ease: 'none' });\n\n  utilityControls.forEach((button) => {\n    const hover = gsap.to(button, { y: -2, scale: 1.06, duration: 0.2, ease: 'power2.out', paused: true });\n    button.addEventListener('pointerenter', () => hover.play());\n    button.addEventListener('pointerleave', () => hover.reverse());\n    button.addEventListener('focus', () => hover.play());\n    button.addEventListener('blur', () => hover.reverse());\n    button.addEventListener('pointerdown', () => gsap.to(button, { scale: 0.94, duration: 0.1, ease: 'power2.out' }));\n    button.addEventListener('pointerup', () => gsap.to(button, { scale: 1.06, duration: 0.16, ease: 'back.out(1.7)' }));\n  });\n  actions.forEach((button) => {\n    const hover = gsap.to(button, { y: -3, scale: 1.02, duration: 0.18, ease: 'power2.out', paused: true });\n    button.addEventListener('pointerenter', () => hover.play());\n    button.addEventListener('pointerleave', () => hover.reverse());\n    button.addEventListener('focus', () => hover.play());\n    button.addEventListener('blur', () => hover.reverse());\n    button.addEventListener('pointerdown', () => gsap.to(button, { scale: 0.96, duration: 0.1, ease: 'power2.out' }));\n    button.addEventListener('pointerup', () => gsap.to(button, { scale: 1.02, duration: 0.16, ease: 'back.out(1.7)' }));\n  });\n})();\n</script>\n",
