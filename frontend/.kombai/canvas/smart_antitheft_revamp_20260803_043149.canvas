      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  :root { --bone:#E3DAC9; --ink:#111111; --orange:#FF5800; --chartreuse:#E3FF00; --muted:#82796b; --paper:#efe8da; }\n  .fo-display { font-family:'Space Grotesk', sans-serif; }\n  .fo-body { font-family:'Fira Sans', sans-serif; }\n  .fo-grid-lines { background-color:#1b1b1b; background-image:linear-gradient(rgba(227,218,201,.075) 1px, transparent 1px), linear-gradient(90deg, rgba(227,218,201,.075) 1px, transparent 1px); background-size:26px 26px; }\n  .fo-cutout { background:linear-gradient(135deg,#30302e 0%,#181818 52%,#3a241b 100%); }\n  .fo-road { stroke:#b7ad9e; stroke-width:2; fill:none; opacity:.78; }\n  .fo-road-thin { stroke:#685f54; stroke-width:1; fill:none; opacity:.65; }\n  .fo-dashed { border-style:dashed; }\n  .fo-hard { box-shadow:4px 4px 0 #111111; }\n  .fo-hard-sm { box-shadow:3px 3px 0 #111111; }\n  .fo-action:hover { box-shadow:6px 6px 0 #111111; transform:translate(-2px,-2px); }\n  .fo-nav:hover { background:#252525; color:#E3FF00; }\n  .fo-toggle { position:relative; width:52px; height:28px; border:2px solid #111; background:#5a554d; flex:none; }\n  .fo-toggle::after { content:''; position:absolute; top:3px; left:3px; width:18px; height:18px; background:#E3DAC9; border:2px solid #111; }\n  .fo-toggle-on { background:#E3FF00; }\n  .fo-toggle-on::after { left:27px; background:#111; }\n  @media (max-width: 900px) { .fo-shell { grid-template-columns:1fr !important; } .fo-sidebar { position:relative !important; } .fo-nav-grid { grid-template-columns:repeat(4,1fr); } .fo-bento { grid-template-columns:1fr !important; } .fo-span { grid-column:span 1 !important; grid-row:span 1 !important; } .fo-actions { position:relative !important; } }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<div class=\"fo-body min-h-screen bg-[#E3DAC9] p-5 text-[#111111] sm:p-7\" data-kid=\"1\">\n    <div class=\"fo-shell mx-auto grid max-w-[1440px] grid-cols-[236px_1fr] gap-6\" data-kid=\"1-1\">\n        <aside class=\"fo-sidebar fo-hard sticky top-5 flex min-h-[calc(100vh-40px)] flex-col border-2 border-[#111111] bg-[#111111] p-4 text-[#E3DAC9]\" data-kid=\"1-1-1\">\n            <div class=\"border-b-2 border-[#E3DAC9]/25 pb-5\" data-kid=\"1-1-1-1\">\n                <div class=\"mb-5 flex items-start justify-between\" data-kid=\"1-1-1-1-1\">\n                    <div data-kid=\"1-1-1-1-1-1\">\n                        <div class=\"fo-display text-[10px] font-bold tracking-[0.22em] text-[#E3FF00]\" data-kid=\"1-1-1-1-1-1-1\">\n                            SAT // 01\n                        </div>\n                        <div class=\"fo-display mt-1 text-xl font-bold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1-1-2\">\n                            FIELD OPS\n                        </div>\n                    </div>\n                    <div aria-label=\"Smart Anti-Theft logo\" class=\"grid h-10 w-10 place-items-center border-2 border-[#E3FF00] text-[#E3FF00]\" data-kid=\"1-1-1-1-1-2\">\n                        <i class=\"ti ti-shield-lock text-xl\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"shield lock icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 border-2 border-[#E3FF00] bg-[#1d2710] px-3 py-2 text-[11px] font-semibold tracking-[0.1em] text-[#E3FF00]\" data-kid=\"1-1-1-1-2\" data-name=\"secure link live status\">\n                    <span class=\"fo-pulse h-2.5 w-2.5 rounded-full bg-[#E3FF00]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-2-1\" data-name=\"pulse animation indicator\" data-reason=\"scaled and faded by heartbeat script\">\n                    </span>\n                    SECURE LINK / LIVE\n                </div>\n            </div>\n            <nav aria-label=\"Điều hướng chính\" class=\"fo-nav-grid mt-6 flex flex-1 flex-col gap-2\" data-kid=\"1-1-1-2\">\n                <div class=\"fo-nav border-2 border-[#E3FF00] bg-[#E3FF00] px-3 py-3 text-[#111111]\" data-kid=\"1-1-1-2-1\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2-1-1\">\n                        <i class=\"ti ti-layout-dashboard text-lg\" data-kid=\"1-1-1-2-1-1-1\">\n                        </i>\n                        <span class=\"fo-display text-xs font-bold uppercase tracking-[0.08em]\" data-kid=\"1-1-1-2-1-1-2\">\n                            Tổng quan\n                        </span>\n                    </div>\n                    <span class=\"mt-1 block pl-7 text-[10px] font-semibold uppercase\" data-kid=\"1-1-1-2-1-2\">\n                        live board\n                    </span>\n                </div>\n                <div class=\"fo-nav border-2 border-transparent px-3 py-3\" data-kid=\"1-1-1-2-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2-2-1\">\n                        <i class=\"ti ti-device-mobile text-lg\" data-kid=\"1-1-1-2-2-1-1\">\n                        </i>\n                        <span class=\"fo-display text-xs font-bold uppercase tracking-[0.08em]\" data-kid=\"1-1-1-2-2-1-2\">\n                            Thiết bị\n                        </span>\n                    </div>\n                </div>\n                <div class=\"fo-nav border-2 border-transparent px-3 py-3\" data-kid=\"1-1-1-2-3\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2-3-1\">\n                        <i class=\"ti ti-map-2 text-lg\" data-kid=\"1-1-1-2-3-1-1\">\n                        </i>\n                        <span class=\"fo-display text-xs font-bold uppercase tracking-[0.08em]\" data-kid=\"1-1-1-2-3-1-2\">\n                            Bản đồ\n                        </span>\n                    </div>\n                </div>\n                <div class=\"fo-nav border-2 border-transparent px-3 py-3\" data-kid=\"1-1-1-2-4\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2-4-1\">\n                        <i class=\"ti ti-history text-lg\" data-kid=\"1-1-1-2-4-1-1\">\n                        </i>\n                        <span class=\"fo-display text-xs font-bold uppercase tracking-[0.08em]\" data-kid=\"1-1-1-2-4-1-2\">\n                            Lịch sử\n                        </span>\n                    </div>\n                </div>\n            </nav>\n            <div class=\"border-t-2 border-[#E3DAC9]/25 pt-4\" data-kid=\"1-1-1-3\">\n                <div class=\"mb-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#aaa092]\" data-kid=\"1-1-1-3-1\">\n                    Operator\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3-2\">\n                    <div class=\"grid h-9 w-9 place-items-center border-2 border-[#E3DAC9] bg-[#3a3732] fo-display font-bold\" data-kid=\"1-1-1-3-2-1\">\n                        NM\n                    </div>\n                    <div data-kid=\"1-1-1-3-2-2\">\n                        <div class=\"fo-display text-sm font-bold\" data-kid=\"1-1-1-3-2-2-1\">\n                            Nguyễn Minh\n                        </div>\n                        <div class=\"text-[11px] text-[#aaa092]\" data-kid=\"1-1-1-3-2-2-2\">\n                            primary owner\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex items-center justify-between text-[10px] uppercase tracking-[0.12em] text-[#aaa092]\" data-kid=\"1-1-1-3-3\">\n                    <span data-kid=\"1-1-1-3-3-1\">\n                        Build 2.4.8\n                    </span>\n                    <i class=\"ti ti-settings text-base\" data-kid=\"1-1-1-3-3-2\" title=\"Cài đặt\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0\" data-kid=\"1-1-2\">\n            <header class=\"fo-reveal mb-5 flex flex-wrap items-end justify-between gap-4 border-b-2 border-[#111111] pb-5\" data-kid=\"1-1-2-1\">\n                <div data-kid=\"1-1-2-1-1\">\n                    <div class=\"fo-display mb-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#6f665b]\" data-kid=\"1-1-2-1-1-1\">\n                        SMART ANTI-THEFT / COMMAND BOARD / 08.03.2026\n                    </div>\n                    <h1 class=\"fo-display text-4xl font-bold uppercase leading-none tracking-[-0.06em] sm:text-5xl\" data-kid=\"1-1-2-1-1-2\">\n                        Bảo vệ đang bật\n                        <span class=\"text-[#FF5800]\" data-kid=\"1-1-2-1-1-2-1\">\n                            .\n                        </span>\n                    </h1>\n                    <p class=\"mt-2 max-w-xl text-sm font-medium text-[#60584d]\" data-kid=\"1-1-2-1-1-3\">\n                        Bảng điều khiển hiện trường cho thiết bị bị thất lạc — theo dõi, khoá và thu hồi dữ liệu từ xa.\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"fo-live-badge fo-hard-sm flex items-center gap-2 border-2 border-[#111111] bg-[#E3FF00] px-3 py-2 text-xs font-bold uppercase tracking-[0.08em]\" data-kid=\"1-1-2-1-2-1\" data-name=\"tracking active status badge\">\n                        <span class=\"fo-pulse h-2 w-2 rounded-full bg-[#111111]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"tracking status pulse indicator\" data-reason=\"scaled and faded by heartbeat script\">\n                        </span>\n                        Tracking active\n                    </div>\n                    <button aria-label=\"Mở thông báo\" class=\"fo-hard-sm border-2 border-[#111111] bg-[#E3DAC9] px-3 py-2 text-lg\" data-kid=\"1-1-2-1-2-2\" title=\"Thông báo\">\n                        <i class=\"ti ti-bell\" data-kid=\"1-1-2-1-2-2-1\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <section aria-label=\"Tổng quan trạng thái\" class=\"fo-reveal mb-5 grid grid-cols-12 gap-4\" data-kid=\"1-1-2-2\">\n                <div class=\"col-span-12 flex flex-wrap items-center justify-between gap-4 border-2 border-[#111111] bg-[#111111] px-4 py-3 text-[#E3DAC9] fo-hard-sm sm:px-5\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"flex items-center gap-4\" data-kid=\"1-1-2-2-1-1\">\n                        <span class=\"fo-display text-[11px] font-bold uppercase tracking-[0.16em] text-[#E3FF00]\" data-kid=\"1-1-2-2-1-1-1\">\n                            ACTIVE ASSET\n                        </span>\n                        <span class=\"hidden h-5 w-px bg-[#E3DAC9]/35 sm:block\" data-kid=\"1-1-2-2-1-1-2\">\n                        </span>\n                        <span class=\"fo-display text-sm font-bold\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-3\" data-name=\"active device name text\" data-reason=\"reinitialized by data update script\">\n                            Galaxy S24 Ultra\n                        </span>\n                        <span class=\"hidden text-xs text-[#aaa092] sm:inline\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-1-4\" data-name=\"active device details\" data-reason=\"reinitialized by data update script\">\n                            · Android 14 · SAT-8841-AX\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-5 text-xs\" data-kid=\"1-1-2-2-1-2\">\n                        <span data-kid=\"1-1-2-2-1-2-1\">\n                            <span class=\"text-[#aaa092]\" data-kid=\"1-1-2-2-1-2-1-1\">\n                                LAST PING\n                            </span>\n                            <b class=\"text-[#E3FF00]\" data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"last ping timestamp\" data-reason=\"text replaced every few seconds by sync script\">\n                                12 sec ago\n                            </b>\n                        </span>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-2-2-1-2-2\">\n                            <span class=\"text-[#aaa092]\" data-kid=\"1-1-2-2-1-2-2-1\">\n                                ACCURACY\n                            </span>\n                            <b data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-2-2\" data-name=\"location accuracy value\" data-reason=\"text replaced every few seconds by sync script\">\n                                4.2 m\n                            </b>\n                        </span>\n                        <span class=\"hidden sm:inline\" data-kid=\"1-1-2-2-1-2-3\">\n                            <span class=\"text-[#aaa092]\" data-kid=\"1-1-2-2-1-2-3-1\">\n                                ZONE\n                            </span>\n                            <b data-dynamic=\"true\" data-kid=\"1-1-2-2-1-2-3-2\" data-name=\"location zone identifier\" data-reason=\"text replaced every few seconds by sync script\">\n                                Q1 / HCMC\n                            </b>\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section aria-label=\"Field Ops dashboard\" class=\"fo-bento grid grid-cols-12 gap-4\" data-kid=\"1-1-2-3\">\n                <article class=\"fo-reveal fo-span fo-hard col-span-5 row-span-2 border-2 border-[#111111] bg-[#efe8da] p-5\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"flex items-start justify-between border-b-2 border-[#111111] pb-4\" data-kid=\"1-1-2-3-1-1\">\n                        <div data-kid=\"1-1-2-3-1-1-1\">\n                            <div class=\"fo-display text-xs font-bold uppercase tracking-[0.15em]\" data-kid=\"1-1-2-3-1-1-1-1\">\n                                Active device / 01\n                            </div>\n                            <h2 class=\"fo-display mt-2 text-2xl font-bold uppercase tracking-[-0.04em]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-1-1-2\" data-name=\"device name header\" data-reason=\"reinitialized by data update script\">\n                                Galaxy S24 Ultra\n                            </h2>\n                            <div class=\"mt-1 text-xs font-medium text-[#6f665b]\" data-kid=\"1-1-2-3-1-1-1-3\">\n                                Owner: Nguyễn Minh · Mobile endpoint\n                            </div>\n                        </div>\n                        <div class=\"grid h-12 w-12 place-items-center border-2 border-[#111111] bg-[#E3FF00] text-2xl\" data-kid=\"1-1-2-3-1-1-2\">\n                            <i class=\"ti ti-device-mobile\" data-kid=\"1-1-2-3-1-1-2-1\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 flex items-center gap-5\" data-kid=\"1-1-2-3-1-2\">\n                        <div class=\"relative h-36 w-36 shrink-0\" data-kid=\"1-1-2-3-1-2-1\">\n                            <svg aria-label=\"Battery 72 percent\" class=\"h-full w-full overflow-visible\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-2-1-1\" data-name=\"battery charge level svg chart\" data-reason=\"dash offset and path rendered by script\" viewbox=\"0 0 160 100\">\n                                <path d=\"M18 88 A62 62 0 0 1 142 88\" fill=\"none\" stroke=\"#b5ac9e\" stroke-width=\"13\">\n                                </path>\n                                <path d=\"M18 88 A62 62 0 0 1 142 88\" fill=\"none\" stroke=\"#E3FF00\" stroke-dasharray=\"280\" stroke-dashoffset=\"78\" stroke-linecap=\"square\" stroke-width=\"13\">\n                                </path>\n                                <text fill=\"#111111\" font-family=\"Space Grotesk\" font-size=\"27\" font-weight=\"700\" text-anchor=\"middle\" x=\"80\" y=\"75\">\n                                    72%\n                                </text>\n                                <text fill=\"#6f665b\" font-family=\"Fira Sans\" font-size=\"9\" letter-spacing=\"1.5\" text-anchor=\"middle\" x=\"80\" y=\"95\">\n                                    BATTERY\n                                </text>\n                            </svg>\n                        </div>\n                        <div class=\"min-w-0\" data-kid=\"1-1-2-3-1-2-2\">\n                            <div class=\"fo-display text-4xl font-bold\" data-kid=\"1-1-2-3-1-2-2-1\">\n                                72\n                                <span class=\"text-xl\" data-kid=\"1-1-2-3-1-2-2-1-1\">\n                                    %\n                                </span>\n                            </div>\n                            <div class=\"mt-1 text-xs font-semibold uppercase tracking-[0.12em] text-[#6f665b]\" data-kid=\"1-1-2-3-1-2-2-2\">\n                                estimated 9h 14m\n                            </div>\n                            <div class=\"mt-4 flex items-center gap-2 text-sm font-bold\" data-kid=\"1-1-2-3-1-2-2-3\">\n                                <i class=\"ti ti-wifi text-lg text-[#4c8317]\" data-kid=\"1-1-2-3-1-2-2-3-1\">\n                                </i>\n                                Network secure\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#6f665b]\" data-kid=\"1-1-2-3-1-2-2-4\">\n                                5G · VPN tunnel verified\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-5 border-2 border-[#111111] bg-[#111111] p-4 text-[#E3DAC9]\" data-kid=\"1-1-2-3-1-3\">\n                        <div class=\"flex items-center justify-between\" data-kid=\"1-1-2-3-1-3-1\">\n                            <span class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#aaa092]\" data-kid=\"1-1-2-3-1-3-1-1\">\n                                Current position\n                            </span>\n                            <span class=\"text-[10px] font-bold text-[#E3FF00]\" data-kid=\"1-1-2-3-1-3-1-2\">\n                                GPS LOCK\n                            </span>\n                        </div>\n                        <div class=\"fo-display mt-2 text-xl font-bold\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-3-2\" data-name=\"current location address\" data-reason=\"text updated based on geolocation feed\">\n                            Quận 1 · TP. Hồ Chí Minh\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2 text-xs text-[#aaa092]\" data-kid=\"1-1-2-3-1-3-3\">\n                            <i class=\"ti ti-map-pin text-[#FF5800]\" data-kid=\"1-1-2-3-1-3-3-1\" data-name=\"location pin icon\">\n                            </i>\n                            10.7769° N  106.7009° E\n                        </div>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between border-t-2 border-[#111111] pt-4\" data-kid=\"1-1-2-3-1-4\">\n                        <div data-kid=\"1-1-2-3-1-4-1\">\n                            <div class=\"fo-display text-xs font-bold uppercase\" data-kid=\"1-1-2-3-1-4-1-1\">\n                                Protection score\n                            </div>\n                            <div class=\"mt-1 text-xs text-[#6f665b]\" data-kid=\"1-1-2-3-1-4-1-2\">\n                                3 / 3 safeguards active\n                            </div>\n                        </div>\n                        <div class=\"fo-display text-3xl font-bold text-[#4c8317]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-4-2\" data-name=\"protection status score\" data-reason=\"value updated based on security policy scan\">\n                            A\n                            <span class=\"text-base\" data-kid=\"1-1-2-3-1-4-2-1\">\n                                +\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"fo-reveal fo-span fo-hard fo-cutout relative col-span-7 row-span-2 min-h-[430px] overflow-hidden border-2 border-[#111111] p-4 text-[#E3DAC9]\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"absolute inset-0 fo-grid-lines opacity-80\" data-kid=\"1-1-2-3-2-1\">\n                    </div>\n                    <div class=\"relative z-10 flex items-start justify-between\" data-kid=\"1-1-2-3-2-2\">\n                        <div data-kid=\"1-1-2-3-2-2-1\">\n                            <div class=\"fo-display text-xs font-bold uppercase tracking-[0.16em] text-[#E3FF00]\" data-kid=\"1-1-2-3-2-2-1-1\">\n                                Tactical map / live trace\n                            </div>\n                            <div class=\"fo-display mt-2 text-2xl font-bold uppercase\" data-kid=\"1-1-2-3-2-2-1-2\">\n                                Q1 · Sector 04\n                            </div>\n                        </div>\n                        <div class=\"border-2 border-[#E3FF00] bg-[#111111]/80 px-3 py-2 text-right\" data-kid=\"1-1-2-3-2-2-2\">\n                            <div class=\"text-[10px] uppercase tracking-[0.12em] text-[#aaa092]\" data-kid=\"1-1-2-3-2-2-2-1\">\n                                Signal\n                            </div>\n                            <div class=\"fo-display text-lg font-bold text-[#E3FF00]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-2-2-2\" data-name=\"signal strength value\" data-reason=\"text updated based on signal monitor script\">\n                                -63 dBm\n                            </div>\n                        </div>\n                    </div>\n                    <svg aria-label=\"Bản đồ đường đi thiết bị\" class=\"absolute inset-0 h-full w-full\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-3\" data-name=\"live trace map path\" data-reason=\"path coordinates updated by telemetry script\" preserveaspectratio=\"none\" viewbox=\"0 0 760 440\">\n                        <path class=\"fo-road\" d=\"M0 86 C120 66 194 124 292 98 S448 35 760 88\">\n                        </path>\n                        <path class=\"fo-road\" d=\"M24 352 C132 292 190 318 286 276 S468 220 760 294\">\n                        </path>\n                        <path class=\"fo-road\" d=\"M128 0 C172 82 186 174 162 440\">\n                        </path>\n                        <path class=\"fo-road\" d=\"M474 0 C448 104 514 188 484 440\">\n                        </path>\n                        <path class=\"fo-road-thin\" d=\"M0 188 C114 166 214 204 326 174 S564 126 760 160\">\n                        </path>\n                        <path class=\"fo-road-thin\" d=\"M0 258 C120 230 210 286 360 252 S548 238 760 248\">\n                        </path>\n                        <path class=\"fo-road-thin\" d=\"M612 0 C596 112 650 180 630 440\">\n                        </path>\n                        <path d=\"M94 330 C170 302 209 241 283 264 S389 316 466 244 S566 165 674 126\" fill=\"none\" stroke=\"#E3FF00\" stroke-dasharray=\"10 8\" stroke-width=\"4\">\n                        </path>\n                        <path d=\"M94 330 C170 302 209 241 283 264 S389 316 466 244 S566 165 674 126\" fill=\"none\" opacity=\".12\" stroke=\"#E3FF00\" stroke-width=\"13\">\n                        </path>\n                    </svg>\n                    <div class=\"absolute left-[38%] top-[46%] z-20 -translate-x-1/2 -translate-y-1/2\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-4\" data-name=\"map device location marker\" data-reason=\"marker position reinitialized by live gps coordinate update\">\n                        <div class=\"fo-marker relative grid h-20 w-20 place-items-center\" data-kid=\"1-1-2-3-2-4-1\">\n                            <span class=\"absolute inset-0 rounded-full border border-[#E3FF00]/35\" data-kid=\"1-1-2-3-2-4-1-1\">\n                            </span>\n                            <span class=\"absolute inset-2 rounded-full border border-[#E3FF00]/55\" data-kid=\"1-1-2-3-2-4-1-2\">\n                            </span>\n                            <span class=\"absolute inset-5 rounded-full border-2 border-[#E3FF00]\" data-kid=\"1-1-2-3-2-4-1-3\">\n                            </span>\n                            <span class=\"h-3 w-3 rounded-full bg-[#FF5800] shadow-[0_0_0_5px_#111,0_0_18px_#FF5800]\" data-kid=\"1-1-2-3-2-4-1-4\">\n                            </span>\n                        </div>\n                        <div class=\"fo-hard-sm mt-2 border-2 border-[#111111] bg-[#E3FF00] px-2 py-1 text-center text-[10px] font-bold uppercase text-[#111111]\" data-kid=\"1-1-2-3-2-4-2\">\n                            device now\n                        </div>\n                    </div>\n                    <div class=\"absolute bottom-4 left-4 z-20 border-2 border-[#111111] bg-[#111111]/90 px-3 py-2 text-[10px] font-medium text-[#aaa092]\" data-kid=\"1-1-2-3-2-5\">\n                        <span class=\"mr-2 inline-block h-2 w-2 rounded-full bg-[#E3FF00]\" data-kid=\"1-1-2-3-2-5-1\">\n                        </span>\n                        route synced · 5 points\n                        <span class=\"text-[#E3FF00]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-2-5-2\" data-name=\"map radius display\" data-reason=\"text updated based on accuracy feed\">\n                            4.2 m radius\n                        </span>\n                    </div>\n                    <div class=\"absolute right-4 bottom-4 z-20 flex gap-2\" data-kid=\"1-1-2-3-2-6\">\n                        <button aria-label=\"Phóng to bản đồ\" class=\"fo-hard-sm border-2 border-[#E3DAC9] bg-[#111111] px-3 py-2 text-lg text-[#E3DAC9]\" data-kid=\"1-1-2-3-2-6-1\" title=\"Phóng to\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-1-2-3-2-6-1-1\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Thu nhỏ bản đồ\" class=\"fo-hard-sm border-2 border-[#E3DAC9] bg-[#111111] px-3 py-2 text-lg text-[#E3DAC9]\" data-kid=\"1-1-2-3-2-6-2\" title=\"Thu nhỏ\">\n                            <i class=\"ti ti-minus\" data-kid=\"1-1-2-3-2-6-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n                <article class=\"fo-reveal fo-span fo-hard col-span-5 border-2 border-[#111111] bg-[#111111] p-4 text-[#E3DAC9]\" data-kid=\"1-1-2-3-3\">\n                    <div class=\"mb-3 flex items-center justify-between border-b-2 border-[#E3DAC9]/25 pb-3\" data-kid=\"1-1-2-3-3-1\">\n                        <div data-kid=\"1-1-2-3-3-1-1\">\n                            <div class=\"fo-display text-xs font-bold uppercase tracking-[0.16em] text-[#FF5800]\" data-kid=\"1-1-2-3-3-1-1-1\">\n                                Kill switches\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#aaa092]\" data-kid=\"1-1-2-3-3-1-1-2\">\n                                Remote hardening controls\n                            </div>\n                        </div>\n                        <i class=\"ti ti-bolt text-2xl text-[#FF5800]\" data-kid=\"1-1-2-3-3-1-2\">\n                        </i>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"1-1-2-3-3-2\">\n                        <div class=\"flex items-center justify-between border-2 border-[#3d3a35] bg-[#1c1c1b] px-3 py-2\" data-kid=\"1-1-2-3-3-2-1\">\n                            <div data-kid=\"1-1-2-3-3-2-1-1\">\n                                <div class=\"text-xs font-bold uppercase\" data-kid=\"1-1-2-3-3-2-1-1-1\">\n                                    USB debugging\n                                </div>\n                                <div class=\"text-[10px] text-[#aaa092]\" data-kid=\"1-1-2-3-3-2-1-1-2\">\n                                    blocked by policy\n                                </div>\n                            </div>\n                            <span aria-checked=\"true\" aria-label=\"USB debugging\" class=\"fo-toggle fo-toggle-on\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3-2-1-2\" data-name=\"usb debugging toggle switch\" data-reason=\"checked state toggled by remote hardening script\" role=\"switch\">\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between border-2 border-[#3d3a35] bg-[#1c1c1b] px-3 py-2\" data-kid=\"1-1-2-3-3-2-2\">\n                            <div data-kid=\"1-1-2-3-3-2-2-1\">\n                                <div class=\"text-xs font-bold uppercase\" data-kid=\"1-1-2-3-3-2-2-1-1\">\n                                    Power-off prevention\n                                </div>\n                                <div class=\"text-[10px] text-[#aaa092]\" data-kid=\"1-1-2-3-3-2-2-1-2\">\n                                    active on device\n                                </div>\n                            </div>\n                            <span aria-checked=\"true\" aria-label=\"Power-off prevention\" class=\"fo-toggle fo-toggle-on\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3-2-2-2\" data-name=\"power off prevention toggle switch\" data-reason=\"checked state toggled by remote hardening script\" role=\"switch\">\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between border-2 border-[#3d3a35] bg-[#1c1c1b] px-3 py-2\" data-kid=\"1-1-2-3-3-2-3\">\n                            <div data-kid=\"1-1-2-3-3-2-3-1\">\n                                <div class=\"text-xs font-bold uppercase\" data-kid=\"1-1-2-3-3-2-3-1-1\">\n                                    Lock screen\n                                </div>\n                                <div class=\"text-[10px] text-[#aaa092]\" data-kid=\"1-1-2-3-3-2-3-1-2\">\n                                    biometric required\n                                </div>\n                            </div>\n                            <span aria-checked=\"true\" aria-label=\"Lock screen\" class=\"fo-toggle fo-toggle-on\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3-2-3-2\" data-name=\"lock screen toggle switch\" data-reason=\"checked state toggled by remote hardening script\" role=\"switch\">\n                            </span>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"fo-reveal fo-span fo-hard fo-dashed col-span-7 border-2 border-[#111111] bg-[#efe8da] p-4\" data-kid=\"1-1-2-3-4\">\n                    <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-1-2-3-4-1\">\n                        <div data-kid=\"1-1-2-3-4-1-1\">\n                            <div class=\"fo-display text-xs font-bold uppercase tracking-[0.16em]\" data-kid=\"1-1-2-3-4-1-1-1\">\n                                Security event log\n                            </div>\n                            <div class=\"mt-1 text-[11px] text-[#6f665b]\" data-kid=\"1-1-2-3-4-1-1-2\">\n                                machine proof / latest 24h\n                            </div>\n                        </div>\n                        <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase\" data-kid=\"1-1-2-3-4-1-2\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#FF5800]\" data-kid=\"1-1-2-3-4-1-2-1\">\n                            </span>\n                            1 warning\n                        </div>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"1-1-2-3-4-2\">\n                        <div class=\"relative border-2 border-[#111111] bg-[#f7f1e7] px-3 py-2 pl-4\" data-kid=\"1-1-2-3-4-2-1\">\n                            <span class=\"absolute inset-y-0 left-0 w-1 bg-[#FF5800]\" data-kid=\"1-1-2-3-4-2-1-1\">\n                            </span>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-3-4-2-1-2\">\n                                <span class=\"text-xs font-bold uppercase\" data-kid=\"1-1-2-3-4-2-1-2-1\">\n                                    <i class=\"ti ti-alert-triangle mr-2 text-[#FF5800]\" data-kid=\"1-1-2-3-4-2-1-2-1-1\">\n                                    </i>\n                                    SIM card changed\n                                </span>\n                                <span class=\"fo-display shrink-0 text-[10px] font-bold\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-2-1-2-2\" data-name=\"sim changed event timestamp\" data-reason=\"text timestamp generated by log processing script\">\n                                    02 MIN AGO\n                                </span>\n                            </div>\n                            <div class=\"mt-1 text-[10px] text-[#6f665b]\" data-kid=\"1-1-2-3-4-2-1-3\">\n                                IMEI challenge · 10.7769°N, 106.7009°E\n                            </div>\n                        </div>\n                        <div class=\"relative border-2 border-[#111111] bg-[#f7f1e7] px-3 py-2 pl-4\" data-kid=\"1-1-2-3-4-2-2\">\n                            <span class=\"absolute inset-y-0 left-0 w-1 bg-[#4c8317]\" data-kid=\"1-1-2-3-4-2-2-1\">\n                            </span>\n                            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-2-3-4-2-2-2\">\n                                <span class=\"text-xs font-bold uppercase\" data-kid=\"1-1-2-3-4-2-2-2-1\">\n                                    <i class=\"ti ti-route mr-2 text-[#4c8317]\" data-kid=\"1-1-2-3-4-2-2-2-1-1\">\n                                    </i>\n                                    Geofence exited\n                                </span>\n                                <span class=\"fo-display shrink-0 text-[10px] font-bold\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-2-2-2-2\" data-name=\"geofence exited event timestamp\" data-reason=\"text timestamp generated by log processing script\">\n                                    18 MIN AGO\n                                </span>\n                            </div>\n                            <div class=\"mt-1 text-[10px] text-[#6f665b]\" data-kid=\"1-1-2-3-4-2-2-3\">\n                                Zone: Home / radius 350m · movement confirmed\n                            </div>\n                        </div>\n                        <div class=\"border-2 border-[#111111] bg-[#111111] px-3 py-2 text-[#E3DAC9]\" data-kid=\"1-1-2-3-4-2-3\">\n                            <div class=\"fo-display text-[10px] font-bold uppercase tracking-[0.08em] text-[#E3FF00]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-2-3-1\" data-name=\"latest handshake log entry\" data-reason=\"log line written by handshake listener script\">\n                                [14:26:08] handshake accepted\n                            </div>\n                            <div class=\"mt-1 font-mono text-[10px] text-[#aaa092]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4-2-3-2\" data-name=\"handshake metadata details\" data-reason=\"details updated based on network event\">\n                                cell:VN-HCM-04 · lat:10.7769 · lon:106.7009 · rtt:84ms\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"fo-reveal fo-actions fo-span sticky bottom-4 z-30 col-span-12 flex flex-wrap items-stretch gap-3 border-2 border-[#111111] bg-[#111111] p-3 text-[#E3DAC9] fo-hard\" data-kid=\"1-1-2-3-5\">\n                    <div class=\"mr-auto flex min-w-[160px] items-center gap-3 px-2\" data-kid=\"1-1-2-3-5-1\">\n                        <div class=\"grid h-10 w-10 place-items-center border-2 border-[#E3FF00] text-[#E3FF00]\" data-kid=\"1-1-2-3-5-1-1\">\n                            <i class=\"ti ti-shield-lock text-xl\" data-kid=\"1-1-2-3-5-1-1-1\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-1-2-3-5-1-2\">\n                            <div class=\"fo-display text-xs font-bold uppercase\" data-kid=\"1-1-2-3-5-1-2-1\">\n                                Remote response\n                            </div>\n                            <div class=\"text-[10px] text-[#aaa092]\" data-kid=\"1-1-2-3-5-1-2-2\">\n                                changes apply in seconds\n                            </div>\n                        </div>\n                    </div>\n                    <button aria-label=\"Khóa thiết bị từ xa\" class=\"fo-action fo-press border-2 border-[#E3DAC9] bg-[#111111] px-4 py-3 text-xs font-bold uppercase\" data-kid=\"1-1-2-3-5-2\">\n                        <i class=\"ti ti-lock mr-2 text-base\" data-kid=\"1-1-2-3-5-2-1\">\n                        </i>\n                        Khóa thiết bị\n                    </button>\n                    <button aria-label=\"Phát còi từ xa\" class=\"fo-action fo-press border-2 border-[#E3FF00] bg-[#E3FF00] px-4 py-3 text-xs font-bold uppercase text-[#111111]\" data-kid=\"1-1-2-3-5-3\">\n                        <i class=\"ti ti-volume-2 mr-2 text-base\" data-kid=\"1-1-2-3-5-3-1\">\n                        </i>\n                        Phát còi\n                    </button>\n                    <button aria-label=\"Xóa dữ liệu từ xa\" class=\"fo-action fo-press border-2 border-[#FF5800] bg-[#FF5800] px-4 py-3 text-xs font-bold uppercase text-[#111111]\" data-kid=\"1-1-2-3-5-4\">\n                        <i class=\"ti ti-skull mr-2 text-base\" data-kid=\"1-1-2-3-5-4-1\">\n                        </i>\n                        Xóa dữ liệu\n                        <span class=\"ml-1 text-[10px]\" data-kid=\"1-1-2-3-5-4-2\">\n                            (không thể hoàn tác)\n                        </span>\n                    </button>\n                </div>\n            </section>\n            <div class=\"fo-reveal mt-5 flex flex-wrap items-center justify-between gap-3 border-t-2 border-[#111111] pt-4 text-[10px] font-semibold uppercase tracking-[0.12em] text-[#6f665b]\" data-kid=\"1-1-2-4\">\n                <span data-kid=\"1-1-2-4-1\">\n                    State hints: loading = syncing coordinates · error = connection retry in 30s · empty = pair a device\n                </span>\n                <span data-kid=\"1-1-2-4-2\">\n                    Secure by design · v2.4.8\n                </span>\n            </div>\n        </main>\n    </div>\n</div>\n<script>\n    const media = window.gsap && gsap.matchMedia();\n  if (window.gsap && media) {\n    media.add({ reduceMotion: '(prefers-reduced-motion: reduce)' }, ({ conditions }) => {\n      const noMotion = conditions.reduceMotion;\n      const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });\n      if (noMotion) {\n        gsap.set('.fo-reveal', { autoAlpha: 1, x: 0, y: 0 });\n      } else {\n        intro.from('.fo-reveal', { autoAlpha: 0, y: 20, duration: 0.45, stagger: 0.06 });\n        gsap.to('.fo-pulse', { scale: 1.45, autoAlpha: 0.45, duration: 0.9, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n        gsap.to('.fo-marker', { scale: 1.08, duration: 1.6, repeat: -1, yoyo: true, ease: 'sine.inOut' });\n      }\n      document.querySelectorAll('.fo-press').forEach((button) => {\n        button.addEventListener('pointerdown', () => { if (!noMotion) gsap.to(button, { scale: 0.95, duration: 0.12, ease: 'power2.out' }); });\n        button.addEventListener('pointerup', () => { if (!noMotion) gsap.to(button, { scale: 1, duration: 0.2, ease: 'back.out(2)' }); });\n        button.addEventListener('pointerleave', () => { if (!noMotion) gsap.to(button, { scale: 1, duration: 0.2, ease: 'back.out(2)' }); });\n      });\n    });\n  }\n</script>\n",
